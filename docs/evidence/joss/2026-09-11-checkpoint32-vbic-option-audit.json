  "audit_script": "from pathlib import Path\nimport struct,re,json,math,hashlib\nroot=Path(__file__).resolve().parent\n\ndef read_raw(p):\n header,body=p.read_bytes().split(b'Binary:\\n',1)\n text=header.decode();n=int(re.search(r'No. Variables:\\s*(\\d+)',text)[1]);points=int(re.search(r'No. Points:\\s*(\\d+)',text)[1])\n assert 'Flags: complex' in text and points==1 and len(body)==16*n\n names=[line.split()[1].lower() for line in text.split('Variables:\\n')[1].splitlines() if line.strip()]\n values=struct.unpack('<'+'d'*(2*n),body)\n assert len(names)==n and names[0]=='frequency' and values[0]==1e6\n # The reference's imaginary frequency entry is not an analysis observable.\n result={name:complex(values[2*i],values[2*i+1]) for i,name in enumerate(names) if i and '#' not in name}\n assert result and all(math.isfinite(z.real) and math.isfinite(z.imag) for z in result.values())\n return result\n\nruns=json.loads((root/'delay-runs.json').read_text());assert all(r['returncode']==0 for r in runs)\nreports=[];native=[]\nfor name in ('delay-zero','delay-positive'):\n a=read_raw(root/(name+'-neospice.raw'));b=read_raw(root/(name+'-reference.raw'))\n assert set(a)==set(b)=={'v(c)','v(drive)','v(b)','i(vc)','i(vb)'}\n native.append(a)\n signals=[dict(name=k,neospice=[a[k].real,a[k].imag],reference=[b[k].real,b[k].imag],absolute_error=abs(a[k]-b[k]),normalized_error=abs(a[k]-b[k])/max(abs(b[k]),1e-9)) for k in sorted(a)]\n reports.append(dict(probe=name,frequency_hz=1e6,relative_tolerance=1e-3,denominator_floor=1e-9,passed=all(s['normalized_error']<=1e-3 for s in signals),signals=signals))\nassert native[0]==native[1]\nassert reports[0]['passed'] and not reports[1]['passed']\nresult=dict(scope='Authored single-frequency diagnostic, not a full VBIC option or AC certification',native_delay_invariant=True,comparisons=reports,files={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(root.iterdir()) if p.is_file() and p.name!='audit.json'},audit_script=Path(__file__).read_text())\n(root/'audit.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\\n')\nprint(json.dumps([dict(probe=r['probe'],passed=r['passed'],collector=next(s for s in r['signals'] if s['name']=='i(vc)')) for r in reports],indent=2))\n"
}
