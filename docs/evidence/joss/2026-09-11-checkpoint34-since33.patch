+        ASSERT_NE(dynamic_cast<const VBICDevice*>(device), nullptr);
+        EXPECT_EQ(device->state_vars(), 74);
+    }
+    // ngspice 47 dispatches levels 0, 1 and 2 to its same BJT kernel.
+    for (const std::string name : {"Q_gp0", "Q_gp1", "Q_gp2"}) {
