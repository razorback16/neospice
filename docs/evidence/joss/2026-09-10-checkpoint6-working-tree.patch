+    EXPECT_NEAR(result.voltage("out")[0], 0, 1e-12);
+    for (const auto& [name, values] : result.voltages) EXPECT_EQ(values.size(), 1u);
+    for (const auto& [name, values] : result.currents) EXPECT_EQ(values.size(), 1u);
