+    EXPECT_DOUBLE_EQ(evaluate(0.8, 13.0), 20.0);
+    EXPECT_EQ(evaluate(0.8, 13.0, false), 0.0);
+    // A fresh transient starts with fresh history.
+    EXPECT_EQ(evaluate(0.0, 7.0), 0.0);
+    EXPECT_EQ(evaluate(0.1, 7.0), 0.0);
