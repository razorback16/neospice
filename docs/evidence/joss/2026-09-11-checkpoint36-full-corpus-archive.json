  "generation_script": "from pathlib import Path\nimport json,gzip,hashlib,tarfile\nout=Path('docs/evidence/joss')\narchive=out/'2026-09-11-checkpoint36-full-corpus.tar.gz'\nledger=out/'2026-09-11-checkpoint36-corpus-run47-records.json.gz'\nroot=Path('/tmp/neospice-joss-corpus-run-36-ng47-full')\nexpected=json.loads(gzip.decompress(ledger.read_bytes()))['artifact_sha256']\nseen=set();extra={};count=0\nwith tarfile.open(archive,mode='r|gz') as tar:\n    for member in tar:\n        if member.isdir():continue\n        assert member.isfile(),member.name\n        name=member.name.removeprefix('./')\n        assert name not in seen and name not in extra,name\n        data=tar.extractfile(member).read()\n        assert len(data)==member.size\n        digest=hashlib.sha256(data).hexdigest()\n        if name in expected:\n            assert digest==expected[name],name\n            seen.add(name)\n        else:\n            p=root/name\n            assert p.is_file() and digest==hashlib.sha256(p.read_bytes()).hexdigest(),name\n            extra[name]=dict(bytes=len(data),sha256=digest)\n        count+=1\nassert seen==set(expected),(len(seen),len(expected))\nreport=dict(complete=True,archive=str(archive),bytes=archive.stat().st_size,sha256=hashlib.sha256(archive.read_bytes()).hexdigest(),regular_files_verified=count,audited_artifacts_verified=len(seen),additional_files=extra,ledger=str(ledger),ledger_sha256=hashlib.sha256(ledger.read_bytes()).hexdigest(),scope='Complete run directory including successful and unsuccessful raw outputs. All previously audited artifacts verified directly from the archive; other run metadata matched the completed source directory. No dependency on temporary-directory survival for retained run bytes.',generation_script=Path(__file__).read_text())\np=out/'2026-09-11-checkpoint36-full-corpus-archive.json';p.write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps({k:v for k,v in report.items() if k not in ['generation_script','additional_files']},indent=2))\n"
