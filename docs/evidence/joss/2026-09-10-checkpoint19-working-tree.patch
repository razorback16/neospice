+                reference_geometry[key] = value->v_realdata[0];
+            }
+        }
+        auto circuit = sim_.load(path);
+        const auto actual = std::get<NoiseResult>(sim_.run(circuit).analysis);
+        ASSERT_TRUE(actual.status.converged);
+        bool found_device = false;
